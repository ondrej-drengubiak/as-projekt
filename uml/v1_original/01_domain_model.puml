@startuml
title Doménový model po DDD dekompozícii – triedny diagram (Bounded Contexts)
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

package "Catalog" #E8F1FB {
  class Product <<Entity>> {
    +id : int
    +sku : String
    +name : String
    +price : Money
    +category : String
  }
}
package "Inventory" #E9F7EF {
  class StockItem <<Aggregate Root>> {
    +productId : int
    +quantity : int
    +reserved : int
    +available() : int
    +reserve(qty) : void
    +commit(qty) : void
    +release(qty) : void
  }
}
package "Ordering" #FEF5E7 {
  class Order <<Aggregate Root>> {
    +id : int
    +customerId : int
    +status : OrderStatus
    +total : Money
    +markPaid() : void
    +cancel() : void
  }
  class OrderItem <<Value Object>> {
    +productId : int
    +qty : int
    +unitPrice : Money
  }
  enum OrderStatus {
    PENDING
    PAID
    CANCELLED
  }
  Order "1" *-- "1..*" OrderItem
  Order --> OrderStatus
}
package "Billing" #F9EBEA {
  class CreditAccount <<Aggregate Root>> {
    +customerId : int
    +creditLimit : Money
    +creditUsed : Money
    +authorize(amount) : Payment
  }
  class Payment <<Entity>> {
    +id : int
    +orderId : int
    +amount : Money
    +status : String
  }
  CreditAccount "1" *-- "*" Payment
}
package "Customer" #F4ECF7 {
  class Customer <<Aggregate Root>> {
    +id : int
    +name : String
    +email : String
  }
}
package "Notification" #F2F3F4 {
  class Notification <<Entity>> {
    +orderId : int
    +customerId : int
    +message : String
  }
}
OrderItem ..> Product : productId
StockItem ..> Product : productId
Order ..> Customer : customerId
CreditAccount ..> Customer : customerId
Payment ..> Order : orderId
Notification ..> Order : orderId
note bottom of Order
  Medzi kontextami sa odkazuje
  výhradne identifikátormi (žiadne
  cudzie kľúče ani zdieľané tabuľky).
end note
@enduml
